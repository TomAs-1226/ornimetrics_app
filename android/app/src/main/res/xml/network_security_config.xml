<?xml version="1.0" encoding="utf-8"?>
<!--
  The Ornimetrics feeder is a LAN appliance reached over plain HTTP at a
  user-configurable static IP (e.g. http://192.168.0.86:5000) and via mDNS
  (thomaspi.local). Android blocks cleartext traffic by default on API 28+, so
  we permit it here. Cloud traffic (Firebase, etc.) still uses HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
